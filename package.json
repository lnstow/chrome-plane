{
  "name": "plane",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "bun test",
    "dev": "bun run --parallel dev:app dev:content",
    "dev:app": "vite build --watch",
    "dev:content": "bun run build:content --watch --no-clear-screen",
    "build": "tsc -b && vite build && bun run build:content",
    "build:content": "bun build ./src/content/index.ts --target browser --format iife --outfile ./content.js --banner \"// Generated from src/content/index.ts. Do not edit directly.\"",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-rnd": "^10.5.3",
    "react-virtuoso": "^4.18.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.3",
    "@types/chrome": "^0.2.9",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "happy-dom": "21.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "unocss": "^66.10.2",
    "vite": "^8.3.0"
  }
}
